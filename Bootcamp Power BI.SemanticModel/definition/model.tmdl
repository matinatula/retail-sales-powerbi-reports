model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode","TMDLView_Desktop"]

annotation PBI_QueryOrder = ["dim_date","dim_item","dim_location","fact_sales","DataFolder"]

ref table dim_date
ref table dim_item
ref table dim_location
ref table fact_sales
ref table 'Quarter Selector'

ref cultureInfo en-US

