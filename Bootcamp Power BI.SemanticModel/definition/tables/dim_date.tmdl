	column 'ISO Year' = YEAR ( dim_date[Calendar Date] - WEEKDAY ( dim_date[Calendar Date], 2 ) + 4 )
		formatString: 0
		lineageTag: c6d41ff8-5202-4f89-84e2-ba68e1fcddc7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'ISO Weekday' = WEEKDAY ( dim_date[Calendar Date], 2 )
		formatString: 0
		lineageTag: a028c56a-c966-46f9-b0ca-b5fffd8163d0
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'PY Date' =
			
			CALCULATE (
			    MIN ( dim_date[Calendar Date] ),
			    ALL ( dim_date ),
			    dim_date[ISO Year] = EARLIER ( dim_date[ISO Year] ) - 1,
			    dim_date[ISO Week] = EARLIER ( dim_date[ISO Week] ),
			    dim_date[ISO Weekday] = EARLIER ( dim_date[ISO Weekday] )
			)
		formatString: General Date
		lineageTag: 85e31d73-2bd4-455b-a6b1-7f679c2e1ff9
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Year Quarter' = dim_date[Year] & " " & dim_date[Quarter]
		lineageTag: 00e8dced-3ba0-4b8e-9c1e-2e8009fdd7b4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Quarter Index' = dim_date[Year] * 4 + VALUE ( RIGHT ( dim_date[Quarter], 1 ) )
		lineageTag: a5f9f0f4-e9f2-4810-b279-a45f2119547a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Week Label' = "W" & FORMAT ( dim_date[ISO Week], "00" )
		lineageTag: b9988ec1-dd92-4d18-a031-dffd1d3cdff0
		summarizeBy: none
		sortByColumn: 'ISO Week'

		changedProperty = SortByColumn

