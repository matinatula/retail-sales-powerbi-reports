	measure 'Card Net Sales YoY Color' = VAR _v = [Card Net Sales YoY %] RETURN IF ( ISBLANK ( _v ), BLANK (), IF ( _v >= 0, "#2E7D32", "#C62828" ) )
		lineageTag: 2902c23d-8d42-418b-98d9-496fea849f88

